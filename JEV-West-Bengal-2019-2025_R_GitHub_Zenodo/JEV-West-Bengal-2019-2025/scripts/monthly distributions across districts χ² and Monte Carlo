# ============================================================
# DISTRICT × MONTH ANALYSIS OF JEV-POSITIVE CASES
# North Bengal, 2019–2025
# ============================================================

# Packages
library(dplyr)

# ------------------------------------------------------------
# 1. Enter aggregated district × month JEV-positive counts
# ------------------------------------------------------------

district_month <- matrix(
  c(
    # Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec
      0,   1,  0,  1,  1,  0,  6, 10,  6,  1,  3,  2,   # APD
      2,   5,  1,  3,  0,  1,  3,  7,  6,  2,  2,  1,   # CRB
      4,   5,  4,  3,  3,  3,  9, 14, 11, 15,  9,  5,   # DRJ
      1,   1,  3,  4,  4,  1, 18, 14,  7, 11,  4,  3,   # JAL
      0,   1,  1,  0,  0,  1,  8,  6,  4,  6,  3,  1    # UDJ
  ),
  nrow = 5,
  byrow = TRUE
)

# Assign row and column names
rownames(district_month) <- c("APD", "CRB", "DRJ", "JAL", "UDJ")

colnames(district_month) <- c(
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
)

# Display contingency table
district_month


# ------------------------------------------------------------
# 2. Verify totals
# ------------------------------------------------------------

cat("\nDistrict totals:\n")
print(rowSums(district_month))

cat("\nMonth totals:\n")
print(colSums(district_month))

cat("\nGrand total:\n")
print(sum(district_month))


# ------------------------------------------------------------
# 3. Pearson chi-square test
# ------------------------------------------------------------

chi_result <- chisq.test(district_month, correct = FALSE)

cat("\n==============================\n")
cat("PEARSON CHI-SQUARE TEST\n")
cat("==============================\n")

print(chi_result)


# ------------------------------------------------------------
# 4. Examine expected cell counts
# ------------------------------------------------------------

expected_counts <- chi_result$expected

cat("\nExpected counts:\n")
print(round(expected_counts, 3))

# Number and percentage of cells with expected count <5
n_low_expected <- sum(expected_counts < 5)
total_cells <- length(expected_counts)
percent_low_expected <- 100 * n_low_expected / total_cells

cat("\nCells with expected count <5:",
    n_low_expected, "of", total_cells, "\n")

cat("Percentage of cells with expected count <5:",
    round(percent_low_expected, 1), "%\n")


# ------------------------------------------------------------
# 5. Monte Carlo chi-square test
# ------------------------------------------------------------

set.seed(12345)

chi_mc <- chisq.test(
  district_month,
  correct = FALSE,
  simulate.p.value = TRUE,
  B = 100000
)

cat("\n==============================\n")
cat("MONTE CARLO CHI-SQUARE TEST\n")
cat("==============================\n")

print(chi_mc)


# ------------------------------------------------------------
# 6. Cramér's V
# ------------------------------------------------------------

chi_square <- as.numeric(chi_result$statistic)
N <- sum(district_month)

r <- nrow(district_month)
c <- ncol(district_month)

cramers_v <- sqrt(
  chi_square / (N * min(r - 1, c - 1))
)

cat("\n==============================\n")
cat("CRAMER'S V\n")
cat("==============================\n")

cat("Cramer's V =", round(cramers_v, 3), "\n")


# ------------------------------------------------------------
# 7. Compact results summary
# ------------------------------------------------------------

cat("\n========================================\n")
cat("FINAL RESULTS\n")
cat("========================================\n")

cat(
  "Pearson chi-square =",
  round(chi_square, 3),
  "\n"
)

cat(
  "Degrees of freedom =",
  chi_result$parameter,
  "\n"
)

cat(
  "Monte Carlo p-value =",
  round(chi_mc$p.value, 3),
  "\n"
)

cat(
  "Expected cells <5 =",
  n_low_expected,
  "of",
  total_cells,
  "(",
  round(percent_low_expected, 1),
  "%)\n"
)

cat(
  "Cramer's V =",
  round(cramers_v, 3),
  "\n"
)


# ------------------------------------------------------------
# 8. Publication-ready interpretation
# ------------------------------------------------------------

cat("\nPublication interpretation:\n")

cat(
  "Comparison of the monthly distribution of JEV-positive ",
  "cases across districts using a district × month contingency ",
  "table showed no statistically significant association between ",
  "district and month. Because a large proportion of cells had ",
  "expected counts <5, a Monte Carlo chi-square test was used. ",
  "Cramer's V was 0.209, indicating a relatively small association ",
  "between district and month.\n",
  sep = ""
)
