#===============================================================================
# MONTH-WISE JEV-POSITIVE CASES, 2019–2025
#===============================================================================

library(ggplot2)

#-------------------------------------------------------------------------------
# 1. VERIFIED MONTHLY DATA
#-------------------------------------------------------------------------------

monthly_data <- data.frame(
  Month = factor(
    c("JAN", "FEB", "MAR", "APR", "MAY", "JUN",
      "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"),
    levels = c(
      "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
      "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"
    )
  ),
  
  JEV_Positive_Cases = c(
    7, 13, 9, 11, 8, 6,
    44, 51, 34, 35, 21, 12
  )
)

#-------------------------------------------------------------------------------
# 2. CREATE BAR PLOT
#-------------------------------------------------------------------------------

p <- ggplot(
  monthly_data,
  aes(
    x = Month,
    y = JEV_Positive_Cases
  )
) +
  
  geom_col(
    width = 0.78
  ) +
  
  scale_y_continuous(
    limits = c(0, 55),
    breaks = seq(0, 50, 10),
    expand = c(0, 0)
  ) +
  
  labs(
    x = "Month",
    y = "JEV-Positive Cases"
  ) +
  
  theme_classic(
    base_size = 13
  ) +
  
  theme(
    axis.title = element_text(
      face = "bold"
    ),
    
    axis.text = element_text(
      color = "black"
    ),
    
    axis.ticks = element_line(
      color = "black"
    ),
    
    panel.grid = element_blank(),
    
    plot.margin = margin(
      10, 10, 10, 10
    )
  )

#-------------------------------------------------------------------------------
# 3. DISPLAY
#-------------------------------------------------------------------------------

print(p)

#-------------------------------------------------------------------------------
# 4. SAVE PUBLICATION-QUALITY FIGURE
#-------------------------------------------------------------------------------

ggsave(
  filename = "JEV_Month_Wise_Positive_Cases.png",
  plot = p,
  width = 8,
  height = 5.5,
  units = "in",
  dpi = 300
)

#===============================================================================
# END
#===============================================================================
